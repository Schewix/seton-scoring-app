# Zelená liga - web client environment
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Active event context
VITE_EVENT_ID=00000000-0000-0000-0000-000000000000
VITE_STATION_ID=00000000-0000-0000-0000-000000000001

# Express auth backend
VITE_AUTH_API_URL=https://zelenaliga.cz

# Optional flags
VITE_ADMIN_MODE=0
VITE_AUTH_BYPASS=0

# Serverless content import: Pionyr article images -> Cloudflare R2 WebP variants.
# If these are omitted, article import keeps original image URLs.
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=zelena-liga-gallery
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://gallery.example.com
CONTENT_ARTICLE_R2_PREFIX=articles/pionyr
